{
	admin off
}

:80 {
	# Die API samt Server-Sent Events. flush_interval -1 schickt Ereignisse sofort durch.
	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# Die Web-App ist eine Single-Page-App: unbekannte Pfade liefern index.html.
	handle {
		root * /srv/www
		encode gzip

		# Trunk hängt einen Hash an Skript, WebAssembly und Stile. Diese Dateien ändern sich
		# nie unter demselben Namen und dürfen ewig zwischengespeichert werden.
		@hashed path_regexp ^/.+-[0-9a-f]{16}(_bg)?\.(js|wasm|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Alles andere, vor allem die Startseite, wird bei jedem Aufruf geprüft. Sonst sehen
		# Nutzende nach einem Update noch lange die alte Version.
		@dynamic not path_regexp ^/.+-[0-9a-f]{16}(_bg)?\.(js|wasm|css)$
		header @dynamic Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
