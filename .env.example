# Vorlage für die lokale Konfiguration. Nach .env kopieren und anpassen.
# Die Datei .env gehört nie ins Repository, hier stehen keine echten Zugangsdaten.

# Datenbank (lokale Vorgabe, im Betrieb ein eigenes Passwort setzen: openssl rand -base64 24)
POSTGRES_DB=batterybandits
POSTGRES_USER=batterybandits
POSTGRES_PASSWORD=batterybandits

# Ports auf dem Rechner (nur 127.0.0.1)
WEB_PORT=8080
DB_PORT=5433

# MQTT-Broker. Ohne Profil dev: Broker des Auftraggebers eintragen.
# Mit Profil dev (docker compose --profile dev up) startet ein lokaler Mosquitto.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Leer lassen: TLS ist bei Port 8883 automatisch an. Mit true oder false erzwingen.
MQTT_TLS=
MQTT_TOPIC=trafficnode/+/battery

# Anfangswert des Schwellwerts in Prozent. Spätere Änderungen in der Oberfläche haben Vorrang.
CRITICAL_THRESHOLD_PCT=20

# Simulator (nur Profil dev)
SIM_DEVICES=60
SIM_INTERVAL_SECS=10
SIM_TIME_SCALE=2000
SIM_INVALID_RATE=0.02

RUST_LOG=info
