# Vorlage für die lokale Konfiguration. Nach .env kopieren und anpassen.
# Die Datei .env gehört nie ins Repository, hier stehen keine echten Zugangsdaten.

# Datenbank (lokale Vorgabe, im Betrieb ein eigenes Passwort setzen)
POSTGRES_DB=batterybandits
POSTGRES_USER=batterybandits
POSTGRES_PASSWORD=batterybandits

# Ports auf dem Rechner (nur 127.0.0.1)
DB_PORT=5433
MQTT_PORT=1883

# MQTT. Entwicklung: lokaler Mosquitto (Port 1883, ohne Anmeldung).
# Betrieb: gemeinsamer Broker mqtt.ti-labs.ai Port 8883 (TLS, Zugangsdaten nur hier in .env eintragen).
# Das Topic ist in beiden Fällen das echte aus der Vorlesung und vom Server.
MQTT_HOST=localhost
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_FILTER=traffic-nodes/+/measurements
# Eindeutig je Umgebung (der Broker wird mit anderen Gruppen geteilt).
MQTT_CLIENT_ID=battery-bandits-dev

RUST_LOG=info
