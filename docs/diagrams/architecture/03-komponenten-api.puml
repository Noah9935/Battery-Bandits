@startuml 03-komponenten-api
!include <C4/C4_Component>

title C4 Ebene 3: Komponenten – API-Server

Container(spa, "Web-App", "Rust, Leptos, WebAssembly")
ContainerDb(db, "Datenbank", "PostgreSQL + TimescaleDB")

Container_Boundary(api, "API-Server (Rust, Axum)") {
  Component(router, "Router", "Axum", "Routen unter /api, JSON")
  Component(auth, "AuthLayer", "tower-sessions, argon2", "Login, Session-Cookie, Rollen (F10)")
  Component(devices, "DeviceHandler", "Axum, SQLx", "Geräteliste, Status, Details (F03, F05)")
  Component(history, "HistoryHandler", "Axum, SQLx", "Verlauf, Tageswerte, Prognose (F04, F08)")
  Component(alerts, "AlertHandler", "Axum, SQLx", "Meldungen anzeigen und entscheiden")
  Component(config, "ConfigHandler", "Axum, SQLx", "Warnschwellen und Intervalle (NF07)")
  Component(sse, "SseHub", "tokio broadcast", "LISTEN auf der Datenbank, verteilt Ereignisse an alle offenen Browser (NF01)")
  Component(docs, "OpenAPI", "utoipa", "API-Beschreibung unter /api/docs")
}

Rel(spa, router, "JSON, SSE", "HTTPS über nginx")
Rel(router, auth, "Prüft Session")
Rel(router, devices, "/api/devices")
Rel(router, history, "/api/devices/{id}/history")
Rel(router, alerts, "/api/incidents")
Rel(router, config, "/api/settings")
Rel(router, sse, "/api/events")
Rel(router, docs, "/api/docs")
Rel(auth, db, "Nutzende, Sessions", "SQL")
Rel(devices, db, "SELECT", "SQL")
Rel(history, db, "Hypertable, Continuous Aggregates", "SQL")
Rel(alerts, db, "SELECT, UPDATE", "SQL")
Rel(config, db, "setting", "SQL")
Rel(sse, db, "LISTEN", "SQL")

SHOW_LEGEND()
@enduml
