@startuml 03-komponenten-webapp
!include <C4/C4_Component>

title C4 Ebene 3: Komponenten – Web-App

Person(user, "Nutzende")
Container(api, "API-Server", "Rust, Axum")

Container_Boundary(spa, "Web-App (Rust, Leptos, WebAssembly)") {
  Component(router, "Router", "leptos_router", "/login, /, /karte, /geraete, /geraete/:id, /historie, /postfach, /optionen")
  Component(pages, "Seiten", "Leptos", "Übersicht, Geräte (Liste und Details), Historie, Postfach, Optionen, Tickets (optional)")
  Component(map, "Karte", "Leaflet über wasm-bindgen", "Ampel-Pins, Filter, Route")
  Component(charts, "Diagramme", "charming (ECharts)", "Ladestandsverlauf mit Schwellwert, Tagesstände, Modell-Analyse")
  Component(ui, "UI-Bausteine", "Leptos", "Combobox, Ampelpunkt, Ladestandsbalken, Dialog, Toast")
  Component(state, "AppState", "Leptos Signals", "Geräte, Meldungen, Nutzende; reagiert auf Live-Ereignisse")
  Component(client, "ApiClient", "gloo-net, serde", "REST-Aufrufe mit gemeinsamen Typen aus dem Paket shared")
  Component(live, "LiveClient", "web-sys EventSource", "Empfängt Server-Sent Events")
}

Rel(user, router, "Öffnet", "Browser")
Rel(router, pages, "Rendert")
Rel(pages, map, "Nutzt")
Rel(pages, charts, "Nutzt")
Rel(pages, ui, "Nutzt")
Rel(pages, state, "Liest")
Rel(state, client, "Lädt Daten")
Rel(live, state, "Aktualisiert")
Rel(client, api, "JSON", "HTTPS")
Rel(live, api, "SSE", "HTTPS")

SHOW_LEGEND()
@enduml
