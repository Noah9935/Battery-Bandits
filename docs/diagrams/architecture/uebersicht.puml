@startuml uebersicht
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontSize 13
skinparam ArrowColor #5C5248
skinparam ArrowFontColor #5C5248
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #7A5C3E
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #7A5C3E
}
skinparam actor {
  BorderColor #7A5C3E
}
skinparam nodesep 40
skinparam ranksep 40

title Übersicht Battery Bandits

actor "Nutzende" as user

rectangle caddy [
**Webserver**
Caddy
(Weboberfläche und /api)
]

rectangle dashboard #F3ECE3 [
**Dashboard-Service**
Rust, Axum
]

rectangle ingestion #F3ECE3 [
**Ingestion-Service**
Rust, tokio, rumqttc
]

rectangle monitoring #F3ECE3 [
**Monitoring-Service**
Rust, tokio
]

rectangle operations #F3ECE3 [
**Operations-Service**
Rust, Axum
]

database db [
**Datenbank**
PostgreSQL + TimescaleDB
(Ereignisse per NOTIFY und LISTEN)
]

rectangle broker [
**MQTT-Broker**
Messdatenplattform
]

rectangle tn [
**TrafficNodes**
ca. 500 Geräte
]

user --> caddy : Browser
caddy --> dashboard : /api

tn --> broker : MQTT
broker --> ingestion : MQTT, TLS
ingestion --> db : Messwerte, ReadingSaved
db --> monitoring : LISTEN
monitoring --> db : Status, Prognose
db --> operations : LISTEN
operations --> db : Meldungen, Einsätze
dashboard --> db : SQL (lesend), LISTEN
dashboard --> operations : Kommandos

legend right
  Hinterlegt: eigener Code (Rust, ein Cargo-Workspace)
  Je Dienst ein Container, alles läuft per Docker Compose
endlegend
@enduml
