@startuml uebersicht
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontSize 13
skinparam ArrowColor #5C5248
skinparam ArrowFontColor #5C5248
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #7A5C3E
}
skinparam queue {
  BackgroundColor #FFFFFF
  BorderColor #7A5C3E
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #7A5C3E
}
skinparam actor {
  BorderColor #7A5C3E
}
skinparam nodesep 40
skinparam ranksep 40

title Übersicht Battery Bandits

actor "Nutzende" as user

rectangle web #F3ECE3 [
**Web-App**
Rust, Leptos
]

rectangle caddy [
**Webserver**
Caddy
]

rectangle api #F3ECE3 [
**API-Server**
Rust, Axum
]

rectangle ingest #F3ECE3 [
**MQTT-Empfangsdienst**
Rust, tokio, rumqttc
]

rectangle monitor #F3ECE3 [
**Überwachungs-Service**
Rust, tokio
]

rectangle incidents #F3ECE3 [
**Meldungs-Service**
Rust, tokio
]

queue bus [
**Ereignisbus**
NATS JetStream
]

database db [
**Datenbank**
PostgreSQL + TimescaleDB
(ein Schema je Dienst)
]

rectangle broker [
**MQTT-Broker**
Auftraggeber
]

rectangle tn [
**TrafficNodes**
ca. 500 Geräte
]

rectangle smtp [
**Mailserver**
SMTP (Future Work)
]

user --> web : Browser
web --> caddy : HTTPS
caddy --> api : /api

tn --> broker : MQTT
broker --> ingest : MQTT
ingest --> db : SQL
ingest --> bus : ReadingStored
bus --> monitor : ReadingStored
monitor --> db : SQL
monitor --> bus : DeviceCritical
bus --> incidents : DeviceCritical
incidents --> db : SQL
incidents ..> smtp : E-Mail
api --> db : SQL (lesend)
bus --> api : Live-Updates
api --> bus : Befehle

legend right
  Hinterlegt: eigener Code (Rust, ein Cargo-Workspace)
  Je Dienst ein Container, alles läuft per Docker Compose
endlegend
@enduml
