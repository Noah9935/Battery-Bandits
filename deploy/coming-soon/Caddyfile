# Banner "Kommt bald" für die Domain, auf der noch kein Prod läuft. TLS macht der zentrale Caddy davor.
{
	admin off
	auto_https off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "no-cache"
		-Server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
