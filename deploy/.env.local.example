# Lokaler Test mit Simulator und eigenem Mosquitto. Keine echten Zugangsdaten.
#   docker compose --env-file .env.local.example --profile local up --build
COMPOSE_PROJECT_NAME=battery-bandits-local
WEB_PORT=8080
DB_PORT=5433

POSTGRES_DB=batterybandits
POSTGRES_USER=batterybandits
POSTGRES_PASSWORD=lokal-nur-zum-testen

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_TOPIC_FILTER=traffic-nodes/+/measurements
MQTT_CLIENT_ID=battery-bandits-local

# Simulator: Entladung 60-fach beschleunigt, damit man Veränderungen sieht.
SIM_INTERVAL_SECS=10
SIM_SPEEDUP=60
SIM_INVALID_RATE=0.03
