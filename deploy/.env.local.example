# Lokaler Test mit Simulator und eigenem Mosquitto. Keine echten Zugangsdaten.
#   docker compose --env-file .env.local.example --profile local up --build
COMPOSE_PROJECT_NAME=battery-bandits-local
WEB_PORT=8080
DB_PORT=5433

POSTGRES_DB=batterybandits
POSTGRES_USER=batterybandits
POSTGRES_PASSWORD=lokal-nur-zum-testen

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_TOPIC_FILTER=traffic-nodes/+/measurements
MQTT_CLIENT_ID=battery-bandits-local
# Alles, was hier ankommt, kommt vom Simulator und ist erfunden. Die Oberfläche markiert es entsprechend.
DATA_SOURCE=simulation

# Simulator: Entladung 60-fach beschleunigt, damit man Veränderungen sieht.
SIM_INTERVAL_SECS=10
SIM_SPEEDUP=60
SIM_INVALID_RATE=0.03
# Zahl der erfundenen Geräte (SIM01 bis SIMnn). Mehr Geräte zeigen, wie sich die Oberfläche mit einer großen Flotte verhält.
SIM_DEVICES=60

# Konten für die lokale Anmeldung (nur zum Ausprobieren): name:passwort:Anzeigename, getrennt durch Semikolon.
BB_USERS=noah:noah-lokal:Noah Boufercha:admin;fynn:fynn-lokal:Fynn Becker
AUTH_REQUIRED=true
COOKIE_SECURE=false

# Weiterleitung lokal: E-Mails landen in Mailpit (http://localhost:8025), nichts geht ins Netz.
SMTP_URL=smtp://mailpit:1025
SMTP_FROM=battery-bandits@localhost
PUBLIC_URL=http://localhost:8080
