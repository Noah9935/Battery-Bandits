# Staging (Branch main) auf dem Schulserver. Nach .env kopieren und ausfüllen, die .env nie einchecken.
# Portbereich der Gruppe: 20200 bis 20299, Staging 20210 und 20211.
COMPOSE_PROJECT_NAME=bb-staging
WEB_PORT=20210
# 0.0.0.0: Oberfläche direkt aus dem Internet erreichbar (Port aus dem Bereich der Gruppe). Vorgabe 127.0.0.1.
WEB_BIND=0.0.0.0
DB_PORT=20211

POSTGRES_DB=batterybandits
POSTGRES_USER=batterybandits
# Eigenes starkes Passwort setzen, zum Beispiel mit: openssl rand -base64 24
POSTGRES_PASSWORD=

# Gemeinsamer Broker der Vorlesung (TLS). Zugangsdaten stehen in der vertraulichen YAML der Gruppe.
MQTT_HOST=mqtt.ti-labs.ai
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_FILTER=traffic-nodes/+/measurements
# Muss je Umgebung eindeutig sein: Der Broker wird mit anderen Gruppen geteilt.
MQTT_CLIENT_ID=battery-bandits-staging

# Daten vom gemeinsamen Broker sind echt (Vorgabe). Nur der lokale Simulator setzt simulation.
DATA_SOURCE=dozent

# Anmeldung. Konten: name:passwort:Anzeigename, getrennt durch Semikolon (Passwörter nur hier auf dem Server).
# COOKIE_SECURE=true erst setzen, wenn die Seite über HTTPS erreichbar ist (sonst nimmt der Browser das Cookie nicht an).
BB_USERS=
AUTH_REQUIRED=true
COOKIE_SECURE=false

RUST_LOG=info

# Weiterleitung neuer Meldungen per E-Mail (optional). Ohne Zugang geht Weiterleiten nur per Tipp im Postfach.
# PUBLIC_URL ist die Adresse der Seite und kommt als Link in jede Mail.
PUBLIC_URL=
# So sendet der Server Meldungen selbst, jede Person trägt nur ihre Adresse ein: zum Beispiel
# smtps://alarm%40beispiel.de:PASSWORT@mail.beispiel.de:465 und der Absender. Das @ im Benutzernamen steht als %40, andere
# Sonderzeichen im Passwort ebenfalls kodiert. Am einfachsten setzt es deploy/set-smtp.sh auf dem Server.
SMTP_URL=
SMTP_FROM=

# Erfundene Testgeräte neben den echten Daten (Profil "sim"): eigener Mosquitto, Simulator und zweiter Ingestion-Dienst.
# Der Simulator sendet 50 feste Nodes (SIM01 bis SIM50) im Format der Vorlesung, in Echtzeit. Sie sind in der Oberfläche
# als "Erfunden" gekennzeichnet, der gemeinsame Broker der Vorlesung bekommt davon nichts. Für Prod leer lassen.
COMPOSE_PROFILES=sim
SIM_DEVICES=50
SIM_SPEEDUP=1
